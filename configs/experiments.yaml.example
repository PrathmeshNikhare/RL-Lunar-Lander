# Illustrative configuration contract. Values must be validated and finalized
# during implementation; this file is not executable application code yet.

environment:
  id: LunarLander-v3
  render_mode: null

training:
  algorithm: PPO
  policy: MlpPolicy
  total_timesteps: 1000000
  seed: 42
  policy_kwargs:
    net_arch: [64, 64]

evaluation:
  episodes: 100
  deterministic: true
  use_original_reward: true

experiments:
  baseline:
    reward_mode: original
  time_penalty:
    reward_mode: time_penalty
    coefficient: 0.01
  reward_hacking:
    reward_mode: upright_slow_bonus
    bonus: 1.0
    # Thresholds must be defined from documented observation semantics.
  potential_shaping:
    reward_mode: potential_based
    alpha: 1.0
    # Phi and terminal handling must be explicitly specified before use.
