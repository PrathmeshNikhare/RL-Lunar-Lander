# Original configuration sketch from the project scaffold, kept for reference
# (decision D-022). It is not loaded by any code. The validated experiment
# configs actually used are configs/baseline.yaml, time_penalty.yaml,
# upright_slow_bonus.yaml and potential_shaping.yaml (see lunar_lander_rl/config.py).

environment:
  id: LunarLander-v3
  render_mode: null

training:
  algorithm: PPO
  policy: MlpPolicy
  total_timesteps: 1000000
  seed: 42
  policy_kwargs:
    net_arch: [64, 64]

evaluation:
  episodes: 100
  deterministic: true
  use_original_reward: true

experiments:
  baseline:
    reward_mode: original
  time_penalty:
    reward_mode: time_penalty
    coefficient: 0.01
  reward_hacking:
    reward_mode: upright_slow_bonus
    bonus: 1.0
    # Thresholds must be defined from documented observation semantics.
  potential_shaping:
    reward_mode: potential_based
    alpha: 1.0
    # Phi and terminal handling must be explicitly specified before use.
